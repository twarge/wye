<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect rejects an iOS upload without this key (error 90713).
	     actool merges the icon's CFBundleIcons dictionaries into the built
	     plist but does not write the top-level key the validator reads, so
	     state it here rather than depend on that. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- Export compliance. Twig's only encryption is HTTPS to git remotes,
	     done by the operating system's TLS stack: libgit2 is built against
	     Secure Transport and carries no crypto library of its own (its SHA-1
	     and SHA-256 object hashing is not encryption), and tokens are kept in
	     the system Keychain. Encryption provided by the OS is exempt, so this
	     is false and App Store Connect asks no encryption questions. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Together these show the app's Documents folder in the Files app,
	     which is where repositories on the device live. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
