<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect rejects an iOS upload without this key (error 90713).
	     actool merges the icon's CFBundleIcons dictionaries into the built
	     plist but does not write the top-level key the validator reads, so
	     state it here rather than depend on that. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- Export compliance. Wye encrypts in two ways. HTTPS to git remotes
	     is done by the operating system's TLS stack: libgit2 is built against
	     Secure Transport and carries no crypto library of its own (its SHA-1
	     and SHA-256 object hashing is not encryption). SSH remotes use the
	     SSH protocol implemented in the app (swift-nio-ssh), whose ciphers,
	     key exchange and signatures are the operating system's CryptoKit;
	     private keys and tokens are kept in the system Keychain. The app
	     carries no cryptographic algorithm of its own except bcrypt_pbkdf,
	     used only to read passphrase-protected key files. Whether SSH changes
	     the answer below is the owner's decision: see docs/app-store.md,
	     "Export compliance". The value is unchanged until that is decided. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Together these show the app's Documents folder in the Files app,
	     where repositories cloned by earlier versions live. New ones go in
	     the Files extension's storage instead (Extensions/Files), shown as
	     the Wye location with .git hidden. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<!-- Patch files, so one can be opened in Wye from the Finder, the
		     Files app or a message, to apply to the repository on screen.
		     Alternate: a text editor stays the default. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Patch</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.patch-file</string>
				<string>com.twarge.app.wye.patch</string>
			</array>
		</dict>
	</array>
	<!-- `.patch` and `.diff` have no type every system declares, so Wye
	     imports one for the document type above to name. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.twarge.app.wye.patch</string>
			<key>UTTypeDescription</key>
			<string>Patch</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>patch</string>
					<string>diff</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- wye:// links: the widget opens a repository with one, and the share
	     extension, Services and Shortcuts ask for the clone sheet with one.
	     Sources/WyeShared/WyeLink.swift reads them. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.twarge.app.wye</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wye</string>
			</array>
		</dict>
	</array>
	<!-- Background fetch: Sources/WyeUI/Activity/BackgroundRefresh.swift
	     registers this identifier, and does nothing without it here. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.twarge.app.wye.fetch</string>
		<!-- A clone, fetch, pull or push carried on in the background, with
		     its progress on the Lock Screen: one task each, named under
		     this (Sources/WyeUI/Activity/ContinuedWork.swift). -->
		<string>com.twarge.app.wye.transfer.*</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- Signing in to hosting services with the OAuth device flow, by host.
	     Each value is the client id of an OAuth application the app's
	     publisher registers with that service, with the device flow
	     enabled and no client secret (GitHub: an OAuth app with "Enable
	     Device Flow"; GitLab: a non-confidential application with the
	     "api" and "write_repository" scopes). Empty means Wye offers only
	     personal access tokens for that host. A key per GitHub Enterprise
	     or self-managed GitLab host offers it there too. -->
	<!-- Settings ▸ iCloud ▸ Sync Settings. Off until the app is signed
	     with the iCloud key-value store entitlement, which needs the
	     iCloud capability on the App ID: see docs/app-store.md, "iCloud".
	     Until then the setting is not shown, rather than shown and doing
	     nothing. -->
	<key>WyeSyncsSettingsWithICloud</key>
	<true/>
	<key>WyeOAuthClientIDs</key>
	<dict>
		<key>github.com</key>
		<string></string>
		<key>gitlab.com</key>
		<string></string>
	</dict>
</dict>
</plist>
