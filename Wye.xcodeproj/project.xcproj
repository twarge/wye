{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": ".",
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "Package.swift" },
    { "kind": "folder", "path": "App/Sources", "target-membership": [ "Wye" ] },
    {
      "kind": "folder",
      "path": "Extensions/Widgets",
      "target-membership": [
        "WyeWidgets",
      ],
      "membership-exceptions": [
        {
          "target": "WyeWidgets",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Extensions/Share",
      "target-membership": [
        "WyeShare",
      ],
      "membership-exceptions": [
        {
          "target": "WyeShare",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Extensions/Files",
      "target-membership": [
        "WyeFiles",
      ],
      "membership-exceptions": [
        {
          "target": "WyeFiles",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Extensions/Finder",
      "target-membership": [
        "WyeFinder",
      ],
      "membership-exceptions": [
        {
          "target": "WyeFinder",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "path": "App/Resources/Assets.xcassets", "target-membership": [ "Wye/resources" ] },
    { "path": "App/Resources/AppIcon.icon", "target-membership": [ "Wye/resources" ] },
    { "path": "App/Resources/PrivacyInfo.xcprivacy", "target-membership": [ "Wye/resources" ] },
    { "path": "App/Resources/Localizable.xcstrings", "target-membership": [ "Wye/resources" ] },
    { "path": "App" },
    { "path": "Sources" },
    { "path": "Tests" },
    { "path": "docs" },
    { "path": "scripts" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Wye.app", "id": "1A0000000000000000000011", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/WyeWidgets.appex", "id": "2B0000000000000000000011", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Wye/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WyeShare.appex", "id": "3C0000000000000000000011", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Wye/copy/Embed Foundation Extensions", "platforms": [ "ios", "xros" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WyeFiles.appex", "id": "4D0000000000000000000011", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Wye/copy/Embed Foundation Extensions", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WyeFinder.appex", "id": "5E0000000000000000000011", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Wye/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Wye",
      "id": "1A0000000000000000000200",
      "product": "Products/Wye.app",
      "product-type": "application",
      "dependencies": [
        "WyeWidgets",
        { "target": "WyeShare", "platforms": [ "ios", "xros" ] },
        { "target": "WyeFiles", "platforms": [ "ios" ] },
        { "target": "WyeFinder", "platforms": [ "macos" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Copy Third-Party Licenses",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/scripts/copy-third-party-licenses.sh",
            "$(SRCROOT)/Vendor/libgit2/COPYING",
            "$(SRCROOT)/Vendor/libgit2/deps/llhttp/LICENSE-MIT",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-nio/LICENSE.txt",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-nio/NOTICE.txt",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-nio-ssh/LICENSE.txt",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-nio-transport-services/LICENSE.txt",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-crypto/LICENSE.txt",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-crypto/NOTICE.txt",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-atomics/LICENSE.txt",
            "$(SRCROOT)/Vendor/ThirdPartyLicenses/swift-collections/LICENSE.txt",
            "$(SRCROOT)/LICENSE",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/libgit2/COPYING",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/llhttp/LICENSE-MIT",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-nio/LICENSE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-nio/NOTICE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-nio-ssh/LICENSE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-nio-transport-services/LICENSE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-crypto/LICENSE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-crypto/NOTICE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-atomics/LICENSE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ThirdPartyLicenses/swift-collections/LICENSE.txt",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/LICENSE.txt",
          ],
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/scripts/copy-third-party-licenses.sh\"\n",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "GitKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "WyeUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ALWAYS_SEARCH_USER_PATHS": "NO",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "NO",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]": "App/Wye-iOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]": "App/Wye-iOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "App/Wye.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=xros*]": "App/Wye-iOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=xrsimulator*]": "App/Wye-iOS.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_INJECT_BASE_ENTITLEMENTS": "YES",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT": "dwarf-with-dsym",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "App/Info-macOS.plist",
        "INFOPLIST_FILE[sdk=iphoneos*]": "App/Info-iOS.plist",
        "INFOPLIST_FILE[sdk=iphonesimulator*]": "App/Info-iOS.plist",
        "INFOPLIST_FILE[sdk=xros*]": "App/Info-iOS.plist",
        "INFOPLIST_FILE[sdk=xrsimulator*]": "App/Info-iOS.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Wye",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xros*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xrsimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.app.wye",
        "PRODUCT_NAME": "Wye",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "WyeWidgets",
      "id": "2B0000000000000000000200",
      "product": "Products/WyeWidgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "WyeShared",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]": "Extensions/Widgets/Widgets-iOS.entitlements",
