<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A Finder Sync extension must be sandboxed. It reads the status
	     files the app writes into the shared group container, and nothing
	     of the repositories themselves. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>257KW9ZJFP.com.twarge.app.wye</string>
	</array>
</dict>
</plist>
